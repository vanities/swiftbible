// SwiftBible client config build settings.
//
// Official CI injects these values from Xcode Cloud workflow environment variables.
// For local development, create the ignored file below:
//   ios/swiftbible/GeneratedSecrets.xcconfig
//
// Example local file contents:
//   SUPABASE_URL = https:/$()/your-project.supabase.co
//   SUPABASE_KEY = your-anon-key
//   POSTHOG_API_KEY = phc_...
//   SENTRY_DSN = https://...
//   DEVOTIONAL_READ_SECRET = your-client-read-secret
//
// The optional include lets local builds pick up private values without committing them.
#include? "GeneratedSecrets.xcconfig"

SUPABASE_URL_DEBUG = http:/$()/127.0.0.1:54321

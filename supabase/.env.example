# Copy this file to supabase/.env and fill in real values for local development
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_SECRET_KEY=sk_test_your_key
STRIPE_DONATION_WEBHOOK_SECRET=whsec_your_webhook_secret

DONATION_SUCCESS_URL=swiftbible://donation-success
DONATION_CANCEL_URL=swiftbible://donation-cancel
DONATION_MIN_AMOUNT_CENTS=100
DONATION_MAX_AMOUNT_CENTS=50000

NGROK_AUTHTOKEN=your-ngrok-authtoken
NGROK_DOMAIN=your-domain.ngrok-free.dev

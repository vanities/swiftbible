# Copy this file to .env and fill in your values from App Store Connect.
# .env is gitignored; .env.example is committed as documentation.
#
# Source for credentials:
#   App Store Connect → Users and Access → Integrations → Keys
#   - ASC_KEY_ID:    the 10-char key identifier shown next to your key
#   - ASC_ISSUER_ID: the UUID at the top of the Keys page
#   - ASC_KEY_FILE:  path to the .p8 private key (relative to repo root, or absolute)
#   - ASC_APP_ID:    the Apple ID of your app from App Store Connect → App → General → App Information

ASC_KEY_ID=YOUR_KEY_ID_HERE
ASC_ISSUER_ID=YOUR_ISSUER_UUID_HERE
ASC_APP_ID=YOUR_APP_ID_HERE
ASC_KEY_FILE=AuthKey_YOUR_KEY_ID.p8
